# =============================================
# AINA - Environment Variables
# =============================================

# --- RAILWAY (Backend) ---

# Port Railway akan set otomatis, tidak perlu diisi manual
PORT=3001

# Supabase — server-side admin key (JANGAN expose ke frontend!)
SUPABASE_SERVICE_ROLE_KEY=eyJ...minta_ke_owner

# Supabase — URL project
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase — public anon key (boleh publik)
SUPABASE_ANON_KEY=eyJ...anon_key

# OpenRouter AI key (untuk fitur chat AINA)
OPENROUTER_API_KEY=sk-or-...minta_ke_owner

# Domain frontend Vercel (untuk CORS) — contoh: https://aina.vercel.app
CLIENT_URL=https://your-app.vercel.app


# --- VERCEL (Frontend) ---

# Supabase public vars (di-prefix VITE_ agar bisa diakses frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...anon_key
VITE_SUPABASE_PROJECT_ID=your-project-id

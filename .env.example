# =============================================
# AINA - Environment Variables Template
# =============================================
# Copy file ini menjadi .env dan isi nilainya
# JANGAN commit file .env ke GitHub!

# --- Supabase (Public - aman di frontend) ---
# Dapatkan dari: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...YOUR_ANON_KEY

# --- Supabase (Private - hanya server) ---
# Dapatkan dari: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJ...YOUR_SERVICE_ROLE_KEY

# --- OpenRouter AI ---
# Dapatkan dari: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...YOUR_KEY

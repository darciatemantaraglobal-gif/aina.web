# =============================================
# AINA - Environment Variables
# =============================================
# Hanya 2 nilai ini yang perlu diisi setelah clone.
# Minta ke pemilik project via chat/DM, jangan share di GitHub!

# Supabase server-side key (untuk admin API di server.js)
SUPABASE_SERVICE_ROLE_KEY=eyJ...minta_ke_owner

# OpenRouter AI key (untuk fitur chat AINA)
OPENROUTER_API_KEY=sk-or-...minta_ke_owner


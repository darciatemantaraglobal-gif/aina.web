# =============================================
# AINA - Environment Variables
# =============================================

# --- RAILWAY (Backend) ---

# Port Railway akan set otomatis, tidak perlu diisi manual
PORT=3001

# Supabase — server-side admin key (JANGAN expose ke frontend!)
SUPABASE_SERVICE_ROLE_KEY=eyJ...minta_ke_owner

# Supabase — URL project
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase — public anon key (boleh publik)
SUPABASE_ANON_KEY=eyJ...anon_key

# Opsional — koneksi Postgres langsung, dari Supabase Dashboard →
# Project Settings → Database → Connection string (mode "Session").
# Cuma dipakai untuk auto-seed data contoh di masisir_procedures saat
# server boot pertama. Kalau migrations/004_full_schema_bootstrap.sql
# sudah dijalankan, ini TIDAK wajib — fitur Panduan Prosedur tetap jalan
# lewat Supabase client biasa, cuma tidak ter-seed otomatis (isi manual
# lewat Admin Panel → Prosedur). Lihat migrations/README.md.
DATABASE_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# OpenRouter AI key (untuk fitur chat AINA)
OPENROUTER_API_KEY=sk-or-...minta_ke_owner

# Domain frontend Vercel (untuk CORS) — contoh: https://aina.vercel.app
CLIENT_URL=https://your-app.vercel.app

# Opsional — set "true" HANYA saat butuh terima request dari *.replit.dev /
# *.replit.app / *.vercel.app mana pun (mis. testing preview deploy).
# JANGAN aktifkan di production: CORS di sini pakai credentials:true.
ALLOW_PREVIEW_ORIGINS=false


# --- VERCEL (Frontend) ---

# Supabase public vars (di-prefix VITE_ agar bisa diakses frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...anon_key
VITE_SUPABASE_PROJECT_ID=your-project-id

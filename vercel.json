{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "supportsResponseStreaming": true,
      "includeFiles": "server.js,engine/**,server/**,node_modules/pdf-parse/**,node_modules/pdfjs-dist/**,node_modules/@napi-rs/canvas/**,node_modules/midtrans-client/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/daily",  "schedule": "0 17 * * *" },
    { "path": "/api/cron/weekly", "schedule": "0 18 * * 0" }
  ]
}

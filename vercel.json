{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://ainaweb-production.up.railway.app/api/:path*" },
    { "source": "/share/:path*", "destination": "https://ainaweb-production.up.railway.app/share/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/daily",  "schedule": "0 17 * * *" },
    { "path": "/api/cron/weekly", "schedule": "0 18 * * 0" }
  ]
}
